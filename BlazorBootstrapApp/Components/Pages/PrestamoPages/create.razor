@page "/Prestamo/Create"
@using BlazorBootstrapApp.Services
@using BlazorBootstrapApp.Models
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject PrestamoService prestamoService
@inject LibroService libroService
@inject EstudianteService estudianteService
@inject NavigationManager navegacion
@rendermode InteractiveServer

<PageTitle>Create</PageTitle>

@if (!string.IsNullOrEmpty(Mensaje))
{
    <div class="alert alert-danger">@Mensaje</div>
}

<EditForm Model="Prestamo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Crear prestamo de libro</h5>
            </div>

            <div class="card-body">

                @*Libro*@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.LibroId">
                        <option value="0">Elija una opción</option>
                        @foreach (var libro in ListaLibros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>

                @*Estudiante*@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.EstudianteId">
                        <option value="0">Elija una opción</option>
                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

                @*FechaPrestamo*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de préstamo</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaPrestamo" readonly></InputDate>
                    <ValidationMessage For="(() => Prestamo.FechaPrestamo)" />
                </div>

                @*FechaDevolucion*@
                <div class="mb-3">
                    <label class="form-label"><strong>FechaDevolucion</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaDevolucion"></InputDate>
                    <ValidationMessage For="(() => Prestamo.FechaDevolucion)" />
                </div>

            </div>

            @*footer*@
            <div class="card-footer text-center mt-2">
                <a href="/Prestamo/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Prestamo Prestamo { get; set; } = new Prestamo();
    public string Mensaje { get; set; } = string.Empty;
    public List<Libro> ListaLibros { get; set; } = new List<Libro>();
    public List<Estudiante> ListaEstudiantes { get; set; } = new List<Estudiante>();

    protected override async Task OnInitializedAsync()
    {
        ListaLibros = await libroService.GetList(l => l.Disponible);
        ListaEstudiantes = await estudianteService.GetList(e => e.EstudianteId > 0);
    }

    public async Task Guardar()
    {
        var creado = await prestamoService.Guardar(Prestamo);

        if (creado)
        {
            navegacion.NavigateTo("/Prestamo/Index");
        }
        else
        {
            Mensaje = "No se pudo guardar correctamente";
        }
    }
}
