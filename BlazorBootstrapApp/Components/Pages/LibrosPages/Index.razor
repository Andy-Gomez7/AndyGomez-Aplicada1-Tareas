@page "/Libro/Index"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using BlazorBootstrapApp.Services;
@using BlazorBootstrapApp.Models; 
@inject LibroService libroservice;
@inject NavigationManager navegacion;
@rendermode InteractiveServer


<PageTitle>Indice Libros</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Indice Libros</h5>
            <a href="/Libro/Create" class="btn btn-primary">
                <span class="bi bi-plus-square mt-1"></span> Nuevo Libro
            </a>
        </div>

        <div class="card-body">

            @*Labels*@
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por:</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>Busqueda:</strong></label>
                </div>
            </div>

            @*Filtros*@
            <div class="row align-items-center mb-3">
                <div class="col-3">
                    <select class="form-select" @bind="Filtro">
                        <option value="" disabled>Seleccione</option>
                        <option value="Titulo">Titulo</option>
                        <option value="Autor">Autor</option>
                    </select>
                </div>

                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar">Buscar</button>
                    </div>
                </div>

                <div class="col-2">
                    <button type="button" class="btn btn-outline-primary bi bi-arrow-counterclockwise" @onclick="Restablecer">Reestablecer</button>
                </div>
            </div>

            @* Tabla *@
            <table class="table table-hover">
                <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Titulo</th>
                            <th>Autor</th>
                            <th>Ano de publicacion</th>
                        </tr>
                </thead>
                <tbody>
                    @foreach (var Libro in ListaLibros)
                    {
                        <tr>
                            <td>@Libro.LibroId</td>
                            <td>@Libro.Titulo</td>
                            <td>@Libro.Autor</td>
                            <td>@Libro.AnoPublicacion</td>
                            <td class="text-center">
                                <a href="/Libro/Edit/@Libro.LibroId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer space-between">
             <label>Cantidad: @ListaLibros.Count()</label>
        </div>
    </div>
</div>

@code{
    public List<Libro> ListaLibros { get; set; } = new List<Libro>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync(){
        ListaLibros = await libroservice.GetList(l => l.LibroId >0);
    }

    private async Task Buscar(){

        if(ValorFiltro.Trim() != ""){

            if(Filtro == nameof(Libro.Titulo)){

                ListaLibros = await libroservice.GetList(l => l.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == nameof(Libro.Autor))
            {
                ListaLibros = await libroservice.GetList(l => l.Autor.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
    }

    private async Task Restablecer(){
        ListaLibros = await libroservice.GetList(l => l.LibroId > 0);
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }

}